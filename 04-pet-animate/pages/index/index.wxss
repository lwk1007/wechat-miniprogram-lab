.header {
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 600;
}

.sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #98897f;
  line-height: 1.6;
}

/* 舞台：给动效一个稳定的参考系 */
.stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  background: linear-gradient(180deg, #fff6ee 0%, #fdf8f3 100%);
  border-radius: 28rpx;
}

.pet-wrap {
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #efe6dd;
  /* 让动画只影响自身，不影响布局 */
  will-change: transform;
}

.pet {
  width: 100%;
  height: 100%;
  display: block;
  transform-origin: 50% 90%; /* 以"脚"为支点，比中心点自然 */
}

.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #c9b6a8;
}

.ph-text {
  margin-top: 12rpx;
  font-size: 24rpx;
}

/* ---------- 三个动效：只用 transform，不碰 width/height ---------- */

/* 呼吸：极慢的缩放，模仿胸腹起伏 */
.breath {
  animation: breath 3.2s ease-in-out infinite;
}

@keyframes breath {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.045);
  }
}

/* 跳动：cubic-bezier 让落地有"顿"感，匀速会像电梯 */
.jump {
  animation: jump 1.1s cubic-bezier(0.3, 0.8, 0.4, 1) infinite;
}

@keyframes jump {
  0%,
  100% {
    transform: translateY(0);
  }
  45% {
    transform: translateY(-36rpx) scale(1.02);
  }
  60% {
    transform: translateY(0) scale(0.98);
  }
}

/* 摇晃：小角度旋转 + 轻微位移，适合撒娇 */
.sway {
  animation: sway 2.4s ease-in-out infinite;
}

@keyframes sway {
  0%,
  100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-5deg) translateX(-6rpx);
  }
  75% {
    transform: rotate(5deg) translateX(6rpx);
  }
}

.shadow {
  width: 200rpx;
  height: 22rpx;
  margin-top: 18rpx;
  border-radius: 50%;
  background: rgba(120, 90, 70, 0.14);
  filter: blur(6rpx);
  transition: transform 0.4s ease, opacity 0.4s ease;
}

.shadow-small {
  transform: scaleX(0.72);
  opacity: 0.6;
}

/* ---------- 控件 ---------- */
.toolbar {
  display: flex;
  gap: 16rpx;
  margin: 36rpx 0 24rpx;
}

.chip {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8c7c72;
  background: #fff;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
}

.chip.on {
  color: #c9683f;
  border-color: #e8855b;
  background: #fdeee6;
}

.btn {
  padding: 30rpx;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  background: #e8855b;
  border-radius: 22rpx;
}

.btn:active {
  opacity: 0.86;
}

.tip {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  font-size: 23rpx;
  line-height: 1.8;
  color: #98897f;
  background: #f7f1ea;
  border-radius: 16rpx;
}

.code {
  padding: 2rpx 8rpx;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 6rpx;
}
