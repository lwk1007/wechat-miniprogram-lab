<view class="page">
  <view class="header">
    <view class="title">让照片"活"起来</view>
    <view class="sub">同一张照片，三种循环动效。点宠物还有反馈。</view>
  </view>

  <view class="stage">
    <view class="pet-wrap">
      <image
        wx:if="{{photo}}"
        class="pet {{anim}}"
        src="{{photo}}"
        mode="aspectFill"
        bindtap="onPetTap"
      />
      <view wx:else class="placeholder" bindtap="choose">＋<text class="ph-text">选择照片</text></view>
    </view>

    <!-- 影子跟着动，跳起来时变小，是"落地感"的关键 -->
    <view class="shadow {{anim === 'jump' ? 'shadow-small' : ''}}"></view>
  </view>

  <view class="toolbar">
    <view class="chip {{anim === 'breath' ? 'on' : ''}}" data-anim="breath" bindtap="setAnim">呼吸</view>
    <view class="chip {{anim === 'jump' ? 'on' : ''}}" data-anim="jump" bindtap="setAnim">跳动</view>
    <view class="chip {{anim === 'sway' ? 'on' : ''}}" data-anim="sway" bindtap="setAnim">摇晃</view>
    <view class="chip {{anim === 'none' ? 'on' : ''}}" data-anim="none" bindtap="setAnim">静止</view>
  </view>

  <view class="btn" bindtap="choose">换一张照片</view>

  <view class="tip">
    已点击 {{taps}} 次。改 <text class="code">index.wxss</text> 里的
    <text class="code">@keyframes</text> 参数，就能调出你自己的手感。
  </view>
</view>
