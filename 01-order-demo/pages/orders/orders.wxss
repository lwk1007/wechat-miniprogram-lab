.head {
  padding: 48rpx 40rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 44rpx;
  font-weight: 500;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b4b2a9;
}

.list {
  padding: 0 40rpx;
}

.order {
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-time {
  font-size: 24rpx;
  color: #8a8a86;
}

.order-status {
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #0f6e56;
  background: #e1f5ee;
  border-radius: 8rpx;
}

.order-summary {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.order-bottom {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1efe8;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.order-id {
  font-size: 22rpx;
  color: #b4b2a9;
}

.order-total {
  font-size: 36rpx;
  font-weight: 500;
}

.empty {
  padding-top: 240rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  color: #5f5e5a;
}

.empty-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #b4b2a9;
}

.empty-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 0 56rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #1a1a18;
  color: #ffffff;
  font-size: 28rpx;
}
