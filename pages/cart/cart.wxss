.page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 40rpx 16rpx;
}

.head-title {
  font-size: 34rpx;
  font-weight: 500;
}

.head-clear {
  font-size: 26rpx;
  color: #8a8a86;
}

.list {
  padding: 8rpx 40rpx 0;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.cover {
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cover-text {
  font-size: 40rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.92);
}

.row-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.row-name {
  font-size: 30rpx;
  font-weight: 500;
}

.row-price {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8a86;
}

.stepper {
  display: flex;
  align-items: center;
}

.step {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 26rpx;
  background: #f1efe8;
  color: #1a1a18;
  font-size: 32rpx;
}

.step.solid {
  background: #1d9e75;
  color: #ffffff;
}

.step-qty {
  width: 64rpx;
  text-align: center;
  font-size: 28rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f1efe8;
}

.bar-left {
  display: flex;
  align-items: baseline;
}

.bar-label {
  font-size: 24rpx;
  color: #8a8a86;
  margin-right: 12rpx;
}

.bar-total {
  font-size: 44rpx;
  font-weight: 500;
}

.bar-btn {
  padding: 0 64rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1d9e75;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

.empty {
  padding-top: 240rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  color: #5f5e5a;
}

.empty-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #b4b2a9;
}
