page {
  --bg: #fdf8f3;
  --card: #ffffff;
  --ink: #2b2320;
  --muted: #98897f;
  --accent: #e8855b;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}
