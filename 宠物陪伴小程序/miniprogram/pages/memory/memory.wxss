.page {
  padding-bottom: 48rpx;
}

.retry-btn {
  margin: 32rpx auto 0;
  width: 240rpx;
}

/* ==================================================================
   概览：一起生活的第 N 天
   ================================================================== */
.hero {
  text-align: center;
  padding: 44rpx 32rpx 36rpx;
}
.hero-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.hero-emoji { font-size: 40rpx; }
.hero-title { font-size: 30rpx; font-weight: 500; }
.hero-days {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}
.hero-num {
  font-size: 88rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}
.hero-unit { font-size: 32rpx; color: var(--sub); }
.hero-since { margin-top: 10rpx; font-size: 26rpx; color: var(--sub); }
.hero-stats {
  display: flex;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}
.hero-stat { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 600; color: var(--text); line-height: 1.2; }
.stat-label { margin-top: 4rpx; font-size: 22rpx; color: var(--sub); }

/* ==================================================================
   往年今日（陪伴满一年后出现）
   ================================================================== */
.otd {
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFF9F0 0%, #FDF1E0 100%);
  border: 1rpx solid rgba(192, 139, 78, 0.15);
}
.otd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.otd-title { font-size: 30rpx; font-weight: 600; color: #4A3B28; }
.otd-badge {
  font-size: 22rpx;
  color: #A2834B;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}
.otd-desc { margin-top: 8rpx; font-size: 24rpx; color: #A08B6C; }
.otd-item {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(192, 139, 78, 0.12);
}
.otd-emoji { margin-right: 12rpx; font-size: 26rpx; line-height: 1.6; }
.otd-text { flex: 1; font-size: 25rpx; line-height: 1.6; color: #5A4B36; }
.otd-empty { margin-top: 16rpx; font-size: 24rpx; color: #B09A7C; }

/* ==================================================================
   时间轴
   ================================================================== */
.timeline {
  position: relative;
  margin: 24rpx;
  padding: 8rpx 0;
}
/* 贯穿的竖线：圆点中心线在 x=30rpx */
.tl-line {
  position: absolute;
  left: 30rpx;
  top: 28rpx;
  bottom: 28rpx;
  width: 2rpx;
  margin-left: -1rpx;
  background: var(--line);
}

/* 组头：日期 + 第 N 天 */
.tl-date {
  position: relative;
  display: flex;
  align-items: center;
  padding: 22rpx 0 12rpx;
}
.tl-date-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 4rpx #fff;
  margin: 0 16rpx 0 22rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.tl-date-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--sub);
}
.tl-day-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

/* 事件行 */
.tl-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}
.tl-dot {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid var(--line);
  margin: 0 16rpx 0 8rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
/* 不同类型圆点配色 */
.tl-dot.milestone {
  background: var(--primary);
  border-color: var(--primary);
}
.tl-dot.meet {
  background: #F5E3C8;
  border-color: #E4C79A;
}
.tl-dot.letter {
  background: #FDF2E1;
  border-color: #E8D5B5;
}

/* 事件卡片 */
.tl-card {
  flex: 1;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(28, 40, 34, 0.04);
}
.tl-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text);
}

/* 里程碑：主色高亮 */
.tl-card.milestone { background: var(--primary-light); }
.tl-card.milestone .tl-text { color: var(--primary); font-weight: 500; }

/* 相遇：暖色，和「回忆」的温暖感一致 */
.tl-card.meet {
  background: linear-gradient(135deg, #FFF8EC 0%, #FDF0DD 100%);
  border: 1rpx solid rgba(192, 139, 78, 0.15);
}

/* 来信：暖色，可点进去读信 */
.tl-card.letter {
  background: linear-gradient(135deg, #FFFAF0 0%, #FDF2E1 100%);
  border: 1rpx solid rgba(192, 139, 78, 0.12);
}

/* 思念信：淡橙，和来信的暖黄区分开 */
.tl-card.tribute {
  background: linear-gradient(135deg, #FFF5EE 0%, #FDEADB 100%);
  border: 1rpx solid rgba(190, 120, 70, 0.12);
}
.tl-dot.tribute {
  background: #FDEADB;
  border-color: #E8C8A8;
}
.tl-cta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--primary);
}
