.page {
  padding-bottom: 48rpx;
}

/* 新手引导 */
.onboard {
  margin-top: 96rpx;
  padding: 64rpx 48rpx;
  text-align: center;
}
.onboard-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.onboard-desc { margin-top: 16rpx; }
.onboard-tips {
  text-align: left;
  margin: 40rpx 0 48rpx;
  font-size: 26rpx;
  color: var(--text);
}
.onboard-tip { padding: 8rpx 0; }
.onboard-second { margin-top: 24rpx; }

/* ==================================================================
   场景卡片
   ================================================================== */
.scene-card {
  padding: 0;
  overflow: hidden;
}

/* 场景选择条 */
.scene-bar {
  width: 100%;
  white-space: nowrap;
  padding: 22rpx 20rpx 6rpx;
  box-sizing: border-box;
}
.scene-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 26rpx;
  background: #F1EBDE;
  font-size: 24rpx;
  color: var(--sub);
}
.scene-chip.on {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 500;
}
/* 此刻该去的地方：文字后跟一个小点。
   做成 flex 里的行内元素而不是右上角角标——角标贴在圆角边上，
   看起来像颗脏点，也不跟文字走。已在选中态时不显示，避免和绿底重复提示。 */
.scene-chip.now::after {
  content: '';
  width: 8rpx;
  height: 8rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--primary);
  opacity: 0.45;
}
.scene-chip-icon { margin-right: 8rpx; font-size: 26rpx; }
.scene-chip-name { line-height: 1.2; }

/* 舞台：所有装饰层都绝对定位于此 */
.stage {
  position: relative;
  height: 460rpx;
  margin: 16rpx 20rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
}
.stage > view { position: absolute; }

/* ---------- 草地 ---------- */
.stage-grass {
  background: linear-gradient(180deg, #F6E7CE 0%, #F7ECD6 46%, #EDF0D8 100%);
}
.sun { border-radius: 50%; }
.sun-grass {
  left: 80rpx; top: 56rpx;
  width: 92rpx; height: 92rpx;
  background: radial-gradient(circle at 42% 38%, #FFF6CF 0%, #FFE18C 60%, #FFD36B 100%);
  box-shadow: 0 0 44rpx rgba(255, 214, 120, 0.65);
}
.cloud {
  background: #FFFFFF;
  border-radius: 60rpx;
}
.cloud::before, .cloud::after {
  content: '';
  position: absolute;
  background: #FFFFFF;
  border-radius: 50%;
}
.cloud-a {
  right: 46rpx; top: 104rpx;
  width: 132rpx; height: 42rpx;
  opacity: 0.92;
  animation: cloud-drift 24s ease-in-out infinite;
}
.cloud-a::before { left: 14rpx; top: -30rpx; width: 62rpx; height: 62rpx; }
.cloud-a::after { right: 16rpx; top: -20rpx; width: 46rpx; height: 46rpx; }
.cloud-b {
  left: 46rpx; top: 180rpx;
  width: 92rpx; height: 30rpx;
  opacity: 0.72;
  animation: cloud-drift 32s ease-in-out infinite reverse;
}
.cloud-b::before { left: 10rpx; top: -20rpx; width: 42rpx; height: 42rpx; }

.hill { border-radius: 50% 50% 0 0; }
.hill-back {
  left: -180rpx; bottom: 54rpx;
  width: 760rpx; height: 300rpx;
  background: #C6CCA8;
}
.hill-front {
  right: -140rpx; bottom: 30rpx;
  width: 660rpx; height: 240rpx;
  background: #A9BC82;
}
.tuft {
  width: 8rpx; height: 26rpx;
  background: #7E9A5C;
  border-radius: 8rpx;
}
.tuft-1 { left: 60rpx; bottom: 74rpx; transform: rotate(-12deg); }
.tuft-2 { right: 120rpx; bottom: 94rpx; height: 20rpx; transform: rotate(10deg); }
.ground-grass {
  left: 0; right: 0; bottom: 0;
  height: 92rpx;
  background: linear-gradient(180deg, #8AA566 0%, #68844C 100%);
}

/* ---------- 窗台 ---------- */
.stage-window { background: #F7F0E5; }
.win-glass {
  left: 76rpx; right: 76rpx; top: 52rpx;
  height: 232rpx;
  box-sizing: border-box;
  border: 14rpx solid #FFFFFF;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #F6E7CF 0%, #FBF1DF 100%);
  box-shadow: 0 6rpx 22rpx rgba(176, 156, 128, 0.16);
}
.win-bar-v {
  left: 50%; top: 52rpx;
  width: 12rpx; height: 232rpx;
  margin-left: -6rpx;
  background: #FFFFFF;
}
.win-bar-h {
  left: 76rpx; right: 76rpx; top: 166rpx;
  height: 12rpx;
  background: #FFFFFF;
}
.win-light {
  left: 96rpx; right: 96rpx; top: 292rpx;
  height: 130rpx;
  background: linear-gradient(180deg, rgba(255, 236, 180, 0.6) 0%, rgba(255, 236, 180, 0) 100%);
}
.sill {
  left: 48rpx; right: 48rpx; top: 288rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(176, 156, 128, 0.2);
}
.pot { left: 120rpx; top: 220rpx; width: 84rpx; }
.pot-leaf {
  width: 60rpx; height: 54rpx;
  margin: 0 auto;
  background: #7FBF8B;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-14deg);
}
.pot-body {
  width: 68rpx; height: 42rpx;
  margin: -4rpx auto 0;
  background: #D98E6A;
  border-radius: 0 0 14rpx 14rpx;
}
.ground-floor {
  left: 0; right: 0; bottom: 0;
  height: 148rpx;
  background: linear-gradient(180deg, #E7D2B8 0%, #D9C0A2 100%);
}

/* ---------- 客厅 ---------- */
.stage-living {
  background: linear-gradient(180deg, #F6EEE3 0%, #EFE2D1 100%);
}
.ground-wood {
  left: 0; right: 0; bottom: 0;
  height: 96rpx;
  background: linear-gradient(180deg, #E4CFB4 0%, #D6BB9B 100%);
}
.lv-rug {
  left: 40rpx; right: 40rpx; bottom: 18rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #EBD2C1;
  opacity: 0.85;
}
.lv-sofa-back {
  left: 48rpx; bottom: 178rpx;
  width: 320rpx; height: 86rpx;
  border-radius: 26rpx 26rpx 0 0;
  background: #C3DACC;
}
.lv-sofa {
  left: 62rpx; bottom: 104rpx;
  width: 292rpx; height: 86rpx;
  border-radius: 22rpx 22rpx 10rpx 10rpx;
  background: #A9C7B7;
}
.lv-lamp-pole {
  right: 118rpx; bottom: 96rpx;
  width: 10rpx; height: 118rpx;
  background: #CBB69C;
}
.lv-lamp-base {
  right: 92rpx; bottom: 84rpx;
  width: 62rpx; height: 14rpx;
  border-radius: 8rpx;
  background: #CBB69C;
}
.lv-lamp {
  right: 66rpx; bottom: 200rpx;
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 42%, #FFF7D6 0%, #FFE3A6 66%, #FFD287 100%);
  animation: lamp-glow 4s ease-in-out infinite;
}

/* ---------- 海边 ---------- */
.stage-seaside {
  background: linear-gradient(
    180deg,
    #FFEBCB 0%,
    #FFD99F 30%,
    #BFD8D4 31%,
    #A4C6C0 58%,
    #F5E4C7 59%,
    #EBD2AC 100%
  );
}
.ss-sun {
  left: 90rpx; top: 54rpx;
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFF8D9 0%, #FFD98A 100%);
  box-shadow: 0 0 48rpx rgba(255, 214, 120, 0.7);
}
.ss-wave {
  left: -20rpx; right: -20rpx;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.58);
}
.ss-wave-1 { bottom: 196rpx; animation: wave-bob 5s ease-in-out infinite; }
.ss-wave-2 {
  bottom: 162rpx;
  opacity: 0.42;
  animation: wave-bob 6.6s ease-in-out infinite;
  animation-delay: -2s;
}

/* ---------- 星空 ---------- */
.stage-night {
  background: linear-gradient(180deg, #1C1826 0%, #282234 56%, #332B3E 100%);
}
.nt-moon {
  right: 78rpx; top: 52rpx;
  width: 88rpx; height: 88rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 34%, #FFFDF3 0%, #F2F4E6 72%, #E3E8D7 100%);
  box-shadow: 0 0 46rpx rgba(226, 236, 214, 0.5);
}
.nt-star {
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: #FFF6E4;
  box-shadow: 0 0 8rpx rgba(255, 244, 220, 0.7);
  animation: twinkle 2.8s ease-in-out infinite;
}
/* 星空里大小错落的星：亮星带暖金光晕，暗星细密，才有真实夜空的样子 */
.nt-star.sm { width: 5rpx; height: 5rpx; background: #FFF8E6; box-shadow: none; }
.nt-star.lg { width: 12rpx; height: 12rpx; background: #F7E7B2; box-shadow: 0 0 16rpx rgba(247, 231, 178, 0.85); }
.nt-hill {
  left: -80rpx; right: -80rpx; bottom: -40rpx;
  height: 170rpx;
  background: #17131F;
  border-radius: 50% 50% 0 0;
}
.nt-fly {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #F7D77E;
  box-shadow: 0 0 20rpx #F7D77E;
}
.nt-fly-1 { left: 120rpx; bottom: 150rpx; animation: fly-around 7s ease-in-out infinite; }
.nt-fly-2 { right: 150rpx; bottom: 220rpx; animation: fly-around 9s ease-in-out infinite reverse; }
/* 银河：一条斜向的极淡柔光带，夜空因此有了纵深 */
.nt-galaxy {
  left: -12%; right: -12%; top: 24%;
  height: 150rpx;
  background: linear-gradient(90deg,
    rgba(210, 200, 235, 0) 0%,
    rgba(222, 212, 240, 0.10) 28%,
    rgba(234, 226, 246, 0.15) 50%,
    rgba(222, 212, 240, 0.10) 72%,
    rgba(210, 200, 235, 0) 100%);
  transform: rotate(-16deg);
  border-radius: 50%;
  pointer-events: none;
}

/* ==================================================================
   夜间变体：19 点后「草地 / 窗台 / 客厅 / 海边」也跟着入夜
   ————————————————————————————————————————————————
   三条约束：
   1. 只换光，不动布局。所有规则都是覆盖颜色，元素位置一个没改，
      所以白天调好的构图入夜后不会错位。
   2. 不新增 @keyframes。这一页已经有 16 条动画在跑（云漂 24s、
      浪摆 5s、灯呼吸 4s、星闪 2.8s…），再堆是无谓的合成层开销。
      已有的云漂 / 浪摆 / 灯闪换成新配色后自动成立，不用另写。
   3. 每处都保留「一个亮点」：草地是月亮、窗台是屋里灯光、
      客厅是落地灯、海边是月亮。全压暗会变成一块死黑，反而没层次。
   ================================================================== */

/* ---------- 草地入夜：晴转月夜，绿压成冷绿，云只剩轮廓 ---------- */
.stage-grass.is-night {
  background: linear-gradient(180deg, #2B241E 0%, #383029 46%, #25281F 100%);
}
.stage-grass.is-night .sun-grass {
  background: radial-gradient(circle at 38% 34%, #FFFDF3 0%, #F2F4E6 72%, #E3E8D7 100%);
  box-shadow: 0 0 52rpx rgba(226, 236, 214, 0.4);
}
/* 云不能压成灰色：夜晚的云是被月光从后面打透的，比天空略亮一点点 */
.stage-grass.is-night .cloud,
.stage-grass.is-night .cloud::before,
.stage-grass.is-night .cloud::after {
  background: rgba(233, 220, 196, 0.16);
}
.stage-grass.is-night .hill-back { background: #3B332B; }
.stage-grass.is-night .hill-front { background: #2F2A24; }
.stage-grass.is-night .ground-grass {
  background: linear-gradient(180deg, #2E3627 0%, #242B1E 100%);
}
.stage-grass.is-night .tuft { background: #3C5238; }

/* ---------- 窗台入夜：窗外是夜空，屋里只留一盏暖光 ---------- */
.stage-window.is-night { background: #2C2620; }
.stage-window.is-night .win-glass {
  border-color: #CFCDC4;
  background: linear-gradient(180deg, #2C2520 0%, #3D342C 100%);
  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.3);
}
.stage-window.is-night .win-bar-v,
.stage-window.is-night .win-bar-h,
.stage-window.is-night .sill { background: #CFCDC4; }
.stage-window.is-night .win-light {
  background: linear-gradient(180deg, rgba(255, 214, 140, 0.5) 0%, rgba(255, 214, 140, 0) 100%);
}
.stage-window.is-night .ground-floor {
  background: linear-gradient(180deg, #3A342B 0%, #2C2822 100%);
}
.stage-window.is-night .pot-leaf { background: #3E5C47; }
.stage-window.is-night .pot-body { background: #8A5C44; }

/* ---------- 客厅入夜：家具退到暗部，落地灯顶上来 ---------- */
.stage-living.is-night {
  background: linear-gradient(180deg, #302820 0%, #282019 100%);
}
.stage-living.is-night .ground-wood {
  background: linear-gradient(180deg, #3B3128 0%, #2E2720 100%);
}
.stage-living.is-night .lv-rug { background: #3C3129; }
.stage-living.is-night .lv-sofa-back { background: #33463C; }
.stage-living.is-night .lv-sofa { background: #2B3B32; }
.stage-living.is-night .lv-lamp-pole,
.stage-living.is-night .lv-lamp-base { background: #6B5D4C; }
/* 灯本身不用换色，把光晕放大就够——夜里它该是全屋最亮的点 */
.stage-living.is-night .lv-lamp {
  box-shadow: 0 0 90rpx 34rpx rgba(255, 212, 130, 0.26);
}

/* ---------- 海边入夜：落日换成月亮，海面转深，浪只留一点碎光 ---------- */
.stage-seaside.is-night {
  background: linear-gradient(
    180deg,
    #251F18 0%,
    #332C23 30%,
    #2F3B36 31%,
    #27332E 58%,
    #2F2C25 59%,
    #272218 100%
  );
}
.stage-seaside.is-night .ss-sun {
  background: radial-gradient(circle at 42% 38%, #FFFDF3 0%, #F2F4E6 70%, #E3E8D7 100%);
  box-shadow: 0 0 50rpx rgba(226, 236, 214, 0.42);
}
.stage-seaside.is-night .ss-wave { background: rgba(210, 205, 185, 0.28); }

/* 星空本来就是夜，is-night 加不加都一样，不必写覆盖 */

/* ==================================================================
   宠物层
   ================================================================== */
.pet-layer {
  left: 0; right: 0; top: 0; bottom: 0;
  pointer-events: none;
}
.pet-anchor {
  position: absolute;
  bottom: 52rpx;
  left: 0;
  /* 横向位移全部交给 transform：走合成层，不触发 layout / 子树重排，拖动才跟得住手指 */
  transform: translateX(-50%);
  transition-property: transform;
  transition-timing-function: linear;
  will-change: transform;
  backface-visibility: hidden;
}
.pet-wrap {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  pointer-events: auto;
}
.pet-wrap.facing-left { transform: scaleX(-1); }
.pet-shadow {
  position: absolute;
  left: 50%; bottom: -14rpx;
  width: 148rpx; height: 24rpx;
  margin-left: -74rpx;
  border-radius: 50%;
  background: rgba(48, 38, 28, 0.2);
  transition: width 0.3s ease, margin-left 0.3s ease, opacity 0.3s ease;
}
/* 被提起来时影子变小变淡：离地越高，影子越弱 */
.pet-shadow.up {
  width: 92rpx;
  margin-left: -46rpx;
  opacity: 0.45;
}

/* 提起/落下的位移层：只负责纵向，和锚点的横向走动互不干扰 */
.pet-lift {
  transition: transform 0.34s cubic-bezier(0.34, 1.25, 0.64, 1);
}
.pet-lift.lifted {
  transition: transform 0.08s linear;
}
/* 拖动中：一律不要过渡，手指到哪儿宠物到哪儿 */
.pet-lift.dragging {
  transition: none;
}

.pet-wrap {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  pointer-events: auto;
}
.pet-wrap.facing-left { transform: scaleX(-1); }

/* 身体层：所有动作动画都加在这一层，避免和翻转的 transform 打架 */
.pet-body {
  width: 220rpx;
  height: 220rpx;
  transform-origin: 50% 90%;
  animation: idle-bob 3s ease-in-out infinite;
}
.pet-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 26rpx rgba(48, 38, 28, 0.22);
}
/* 去白底的主体：不套圆角、不投卡片影，靠自己的轮廓站在场景里。
   这里最容易做错的就是「顺手加个圆角好看点」—— 一加就退回贴纸 */
.pet-cut {
  display: block;
  width: 220rpx;
  height: 220rpx;
}
/* 只剩线条时夜里会糊掉，翻成亮线。主体带填充的不翻，一翻身体就变黑 */
.stage.is-night .pet-cut.line {
  filter: invert(1);
}
.pet-generic {
  width: 220rpx;
  height: 220rpx;
  line-height: 220rpx;
  font-size: 116rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
}

/* 走动 / 互动动效（写在待机之后，优先级更高） */
.pet-body.walking { animation: walk-bob 0.52s ease-in-out infinite; }
.pet-body.dangling {
  transform-origin: 50% 4%;
  animation: dangle 1.15s ease-in-out infinite;
}
.anim-touch { animation: nuzzle 0.95s ease; }
.anim-feed { animation: chew 1.4s ease; }
.anim-play { animation: hop 1.05s ease; }
.anim-catch { animation: wiggle 0.8s ease; }
.anim-land { animation: land 0.55s cubic-bezier(0.34, 1.4, 0.64, 1); }

/* 表情：动作之外再给一张脸，情绪一眼能看出 */
.pet-face {
  position: absolute;
  top: -26rpx;
  right: -18rpx;
  font-size: 46rpx;
  line-height: 1;
  animation: face-pop 0.32s cubic-bezier(0.34, 1.5, 0.64, 1);
}
@keyframes face-pop {
  0% { transform: scale(0.2) rotate(-16deg); opacity: 0; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}

/* 喂食：零食从下面飞进嘴里 */
.eat-food {
  position: absolute;
  bottom: 66rpx;
  margin-left: -22rpx;
  font-size: 44rpx;
  line-height: 1;
  pointer-events: none;
  animation: food-fly 1.1s ease-out forwards;
}
@keyframes food-fly {
  0% { transform: translateY(36rpx) scale(0.5); opacity: 0; }
  28% { transform: translateY(6rpx) scale(1); opacity: 1; }
  100% { transform: translateY(-168rpx) scale(0.45); opacity: 0; }
}

/* 玩耍：小球弹两下跑开 */
.play-ball {
  position: absolute;
  bottom: 70rpx;
  margin-left: -20rpx;
  font-size: 40rpx;
  line-height: 1;
  pointer-events: none;
  animation: ball-hop 1.25s ease-out forwards;
}
@keyframes ball-hop {
  0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
  18% { transform: translate(0, -128rpx) scale(1); opacity: 1; }
  36% { transform: translate(70rpx, 0); }
  54% { transform: translate(130rpx, -88rpx); }
  72% { transform: translate(188rpx, 0); }
  88% { transform: translate(238rpx, -44rpx); }
  100% { transform: translate(276rpx, 0); opacity: 0; }
}

@keyframes idle-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}
@keyframes walk-bob {
  0%, 100% { transform: translateY(0) rotate(-1.5deg); }
  50% { transform: translateY(-12rpx) rotate(1.5deg); }
}
/* 被提着脚离地：绕脖子处小幅度摇摆 */
@keyframes dangle {
  0%, 100% { transform: rotate(-7deg) translateY(0); }
  50% { transform: rotate(7deg) translateY(5rpx); }
}
/* 摸头：来回蹭两下 */
@keyframes nuzzle {
  0%, 100% { transform: translateX(0) scale(1); }
  22% { transform: translateX(-8rpx) scale(1.04) rotate(-2deg); }
  52% { transform: translateX(8rpx) scale(1.05) rotate(2deg); }
  78% { transform: translateX(-4rpx) scale(1.02); }
}
/* 吃东西：反复咀嚼，横向略撑开 */
@keyframes chew {
  0%, 100% { transform: scaleY(1) scaleX(1); }
  12% { transform: scaleY(0.9) scaleX(1.05); }
  24% { transform: scaleY(1.03) scaleX(0.98); }
  36% { transform: scaleY(0.9) scaleX(1.05); }
  48% { transform: scaleY(1.03) scaleX(0.98); }
  60% { transform: scaleY(0.92) scaleX(1.04); }
  74% { transform: scaleY(1.02) scaleX(0.99); }
}
/* 玩耍：连着蹦两下，落地有压扁感 */
@keyframes hop {
  0%, 100% { transform: translateY(0) rotate(0); }
  18% { transform: translateY(-72rpx) rotate(-5deg); }
  36% { transform: translateY(0) scaleY(0.94); }
  54% { transform: translateY(-48rpx) rotate(4deg); }
  72% { transform: translateY(0) scaleY(0.96); }
  88% { transform: translateY(-16rpx); }
}
@keyframes wiggle {
  0%, 100% { transform: rotate(0); }
  25% { transform: rotate(8deg); }
  75% { transform: rotate(-8deg); }
}
/* 落地：先压扁再回弹 */
@keyframes land {
  0% { transform: scaleY(1) scaleX(1); }
  22% { transform: scaleY(0.78) scaleX(1.12); }
  48% { transform: scaleY(1.08) scaleX(0.94); }
  72% { transform: scaleY(0.96) scaleX(1.02); }
  100% { transform: scaleY(1) scaleX(1); }
}

/* 说话气泡：跟着宠物横向位置走 */
.bubble-mini {
  position: absolute;
  bottom: 296rpx;
  left: 0;
  /* 和宠物同一条位移轨迹，气泡才不会落在原地 */
  transform: translateX(-50%);
  transition-property: transform;
  transition-timing-function: linear;
  will-change: transform;
  max-width: 340rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 22rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text);
  box-shadow: 0 6rpx 18rpx rgba(48, 38, 28, 0.14);
  word-break: break-all;
}

/* 小心心 */
.hearts {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  pointer-events: none;
}
.heart {
  position: absolute;
  bottom: 0;
  font-size: 40rpx;
  animation: heart-up 1.3s ease-out forwards;
}
@keyframes heart-up {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  20% { opacity: 1; }
  100% { transform: translateY(-260rpx) scale(1.2); opacity: 0; }
}

/* 场景环境动效 */
@keyframes cloud-drift {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(-36rpx); }
}
@keyframes wave-bob {
  0%, 100% { transform: translateX(-14rpx) scaleY(1); }
  50% { transform: translateX(14rpx) scaleY(0.65); }
}
@keyframes twinkle {
  0%, 100% { opacity: 0.35; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.25); }
}
@keyframes fly-around {
  0%, 100% { transform: translate(0, 0); opacity: 0.5; }
  50% { transform: translate(30rpx, -40rpx); opacity: 1; }
}
@keyframes lamp-glow {
  0%, 100% { box-shadow: 0 0 42rpx rgba(255, 212, 138, 0.6); }
  50% { box-shadow: 0 0 62rpx rgba(255, 212, 138, 0.85); }
}

/* ==================================================================
   宠物信息
   ================================================================== */
.scene-info {
  padding: 26rpx 32rpx 32rpx;
  text-align: center;
}
.pet-name {
  font-size: 40rpx;
  font-weight: 600;
}
.pet-status { margin-top: 8rpx; font-size: 26rpx; color: var(--sub); }
.pet-greeting { margin-top: 16rpx; font-size: 26rpx; color: var(--primary); }
.photo-hint { margin-top: 16rpx; }

/* 互动入口 */
.actions {
  display: flex;
  margin: 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 0;
}
.action {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text);
}
.action:active { opacity: 0.6; }
.action-icon { font-size: 48rpx; margin-bottom: 8rpx; }

/* 桌面态入口 */
.desk-entry {
  display: flex;
  align-items: center;
  margin: 0 24rpx;
  padding: 28rpx 32rpx;
  background: var(--card);
  border-radius: 24rpx;
}.desk-entry:active { opacity: 0.7; }
.desk-entry-icon {
  width: 76rpx; height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 40rpx;
  background: var(--primary-light);
  border-radius: 20rpx;
}
.desk-entry-text { flex: 1; margin-left: 24rpx; }
.desk-entry-title { font-size: 30rpx; font-weight: 500; }
.desk-entry-desc { margin-top: 4rpx; font-size: 24rpx; color: var(--sub); }
.desk-entry-arrow { font-size: 40rpx; color: #C9BFA9; }

/* 回忆时间轴入口：淡蓝卡片，和下面的写信/桌面入口区分开 */
.memory-entry {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FBF1DE 0%, #F7E9CE 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(176, 138, 94, 0.16);
}
.memory-entry:active { opacity: 0.75; }
.memory-entry-icon {
  width: 76rpx; height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(176, 138, 94, 0.12);
}
.memory-entry-text { flex: 1; margin-left: 24rpx; }
.memory-entry-title { font-size: 30rpx; font-weight: 500; color: #5A4A30; }
.memory-entry-desc { margin-top: 4rpx; font-size: 24rpx; color: #A08B6C; }
.memory-entry-arrow { font-size: 40rpx; color: #D8C3A5; }

/* 心情日志 + 思念信箱：两个轻量入口并排 */
.mini-entries {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
}
.mini-entry {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--card);
  border-radius: 24rpx;
}
.mini-entry:active { opacity: 0.7; }
.mini-entry-icon {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 36rpx;
  background: var(--primary-light);
  border-radius: 18rpx;
}
.mini-entry-text { margin-left: 16rpx; }
.mini-entry-title { font-size: 28rpx; font-weight: 500; }
.mini-entry-desc { margin-top: 2rpx; font-size: 22rpx; color: var(--sub); }

/* 时光胶囊入口：淡琥珀卡片，时间与等待的意象 */
.time-entry {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FBF5EA 0%, #F6EBD6 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(186, 150, 80, 0.18);
}
.time-entry:active { opacity: 0.75; }
.time-entry-icon {
  width: 76rpx; height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(160, 120, 60, 0.12);
}
.time-entry-text { flex: 1; margin-left: 24rpx; }
.time-entry-title { font-size: 30rpx; font-weight: 500; color: #5A4A28; }
.time-entry-desc { margin-top: 4rpx; font-size: 24rpx; color: #A08B5C; }
.time-entry-arrow { font-size: 40rpx; color: #D8C8A0; }

/* 声音纪念入口：淡紫卡片，声音与记忆的意象 */
.voice-entry {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #F7F0FB 0%, #F1E7F7 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(150, 110, 185, 0.18);
}
.voice-entry:active { opacity: 0.75; }
.voice-entry-icon {
  width: 76rpx; height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(150, 110, 185, 0.12);
}
.voice-entry-text { flex: 1; margin-left: 24rpx; }
.voice-entry-title { font-size: 30rpx; font-weight: 500; color: #5A3A6E; }
.voice-entry-desc { margin-top: 4rpx; font-size: 24rpx; color: #9A7FAE; }
.voice-entry-arrow { font-size: 40rpx; color: #D6C6DE; }

/* 一封信入口：暖色卡片，和下面的桌面入口区分开 */
.letter-entry {
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFFAF0 0%, #FDF2E1 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(192, 139, 78, 0.18);
}
.letter-entry:active { opacity: 0.75; }
.letter-entry-icon {
  width: 76rpx; height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(160, 120, 70, 0.12);
}
.letter-entry-text { flex: 1; margin-left: 24rpx; }
.letter-entry-title { font-size: 30rpx; font-weight: 500; color: #4A3B28; }
.letter-entry-desc { margin-top: 4rpx; font-size: 24rpx; color: #A08B6C; }
.letter-entry-arrow { font-size: 40rpx; color: #D8C3A5; }

.companion-note { margin-top: 8rpx; }
.retry-btn { margin: 32rpx auto 0; width: 240rpx; }

/* ---------------- 自主生命：心情 / 特效 / 补记 / 日记 ---------------- */

.info-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.mood-chip {
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-light);
  border-radius: 999rpx;
  line-height: 1.7;
}

/* 活动特效跟着宠物横向位置走，不占布局。
   定位用 left 百分比、动画只做透明度：如果动画里也写 transform，
   会把模板上的内联 transform 覆盖掉，特效就跑到屏幕左边去了。 */
.pet-effect {
  position: absolute;
  bottom: 132rpx;
  margin-left: -14rpx;
  width: 28rpx;
  text-align: center;
  font-size: 32rpx;
  pointer-events: none;
  animation: effect-fade 4.2s ease-out both;
}
@keyframes effect-fade {
  0% { opacity: 0; }
  12% { opacity: 1; }
  72% { opacity: 1; }
  100% { opacity: 0; }
}

.recap-card { padding: 26rpx 32rpx; }
.recap-title { font-size: 28rpx; font-weight: 500; color: var(--primary); }
.recap-line {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--text);
}
.recap-emoji { margin-right: 12rpx; }
.recap-text { flex: 1; line-height: 1.6; }
.recap-time { margin-left: 12rpx; font-size: 22rpx; color: var(--sub); white-space: nowrap; }

.diary-card { padding: 26rpx 32rpx; }
.diary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.diary-title { font-size: 28rpx; font-weight: 500; }
.diary-list { margin-top: 18rpx; }
.diary-empty { padding: 24rpx 0 8rpx; }
.diary-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--line);
}
.diary-emoji { margin-right: 16rpx; font-size: 26rpx; }
.diary-body { flex: 1; }
.diary-text { font-size: 25rpx; line-height: 1.65; color: var(--text); }
.diary-time { margin-top: 4rpx; font-size: 22rpx; color: var(--sub); }
