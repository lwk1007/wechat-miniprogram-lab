.page {
  padding-bottom: 48rpx;
}

.card-title { font-size: 32rpx; font-weight: 600; }
.card-sub { margin-top: 4rpx; font-size: 24rpx; color: var(--sub); }

/* ---------- 心情选择 ---------- */
.mood-options {
  display: flex;
  justify-content: space-between;
  margin: 28rpx 0 20rpx;
}
.mood-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx 4rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}
.mood-opt.on {
  background: var(--primary-light);
  border-color: var(--primary);
}
.mood-face { font-size: 44rpx; }
.mood-label { margin-top: 6rpx; font-size: 22rpx; color: var(--sub); }
.mood-opt.on .mood-label { color: var(--primary); font-weight: 500; }

.note-input {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  min-height: 120rpx;
  margin-bottom: 24rpx;
}
.note-ph { color: #B8AD96; }

/* ---------- 安心卡 ---------- */
.soothe {
  background: linear-gradient(135deg, #FFF9F0 0%, #FDF1E0 100%);
  border: 1rpx solid rgba(192, 139, 78, 0.15);
}
.soothe-title { font-size: 30rpx; font-weight: 600; color: #4A3B28; }
.soothe-text { margin-top: 12rpx; font-size: 26rpx; line-height: 1.7; color: #5A4B36; }
.soothe-btn { margin-top: 20rpx; }

/* 呼吸引导 */
.breath { margin-top: 20rpx; text-align: center; }
.breath-ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  margin: 8rpx auto 0;
  background: var(--primary-light);
  border: 2rpx solid var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 4s ease-in-out;
  transform: scale(0.8);
}
.breath-ring.in,
.breath-ring.holdIn { transform: scale(1.25); }
.breath-ring.out,
.breath-ring.holdOut { transform: scale(0.8); }
.breath-inner { text-align: center; }
.breath-step { font-size: 30rpx; font-weight: 500; color: var(--primary); }
.breath-left { margin-top: 4rpx; font-size: 44rpx; font-weight: 600; color: var(--text); }
.breath-hint { margin-top: 16rpx; font-size: 24rpx; color: var(--sub); }

/* ---------- 月历回看 ---------- */
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.cal-nav {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--sub);
  border-radius: 50%;
}
.cal-nav:active { background: var(--bg); }
.cal-month { font-size: 30rpx; font-weight: 600; }

.cal-week { display: flex; margin-bottom: 8rpx; }
.cal-week-item {
  width: 14.28%;
  text-align: center;
  font-size: 22rpx;
  color: var(--sub);
}

.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.cal-cell.blank { visibility: hidden; }
.cal-day {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--text);
}
.cal-cell.today .cal-day {
  box-shadow: inset 0 0 0 2rpx var(--primary);
  font-weight: 600;
}

.cal-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--sub);
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.cal-count {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--sub);
}
