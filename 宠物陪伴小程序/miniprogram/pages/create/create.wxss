.steps { padding: 32rpx 32rpx 0; }
.step-bar {
  height: 8rpx;
  background: var(--line);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.step-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.step-desc { margin-top: 8rpx; margin-bottom: 24rpx; }

.photo-box {
  height: 480rpx;
  border-radius: 24rpx;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}
.photo-add {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 48rpx;
  line-height: 96rpx;
  text-align: center;
  margin-bottom: 16rpx;
}
.photo-preview { width: 100%; height: 480rpx; border-radius: 24rpx; }
/* 看透明版时必须换底色：浅色主体压在浅底上，看不出「那张纸已经没了」 */
.photo-stage {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--bg);
}
.photo-stage.is-cut {
  background: linear-gradient(160deg, #E6EAF0 0%, #D4DBE6 100%);
}
.cut-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: var(--bg);
}
.cut-state { font-size: 24rpx; color: var(--text-sub); }
.cut-state.dim { color: #9AA3B2; }
.cut-toggle {
  flex: none;
  margin-left: 16rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-light);
}
.photo-ops { display: flex; justify-content: center; margin-top: 16rpx; }
.photo-op {
  padding: 8rpx 32rpx;
  color: var(--primary);
  font-size: 26rpx;
  background: var(--primary-light);
  border-radius: 32rpx;
  margin: 0 12rpx;
}
.photo-op-remove { color: var(--danger); background: #FBEEEC; }

.name-item { margin-top: 24rpx; }
.personality-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.personality {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
}
.personality-on {
  background: var(--primary-light);
  border-color: var(--primary);
}
.personality-label { font-size: 30rpx; font-weight: 500; margin-bottom: 4rpx; }

.persona-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.optional-title {
  margin: 24rpx 0 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.picker-value { color: var(--text); }

.mode {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  border: 2rpx solid transparent;
}
.mode-on { background: var(--primary-light); border-color: var(--primary); }
.mode-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.mode-title { font-size: 30rpx; font-weight: 500; }
.summary { margin: 24rpx 0; text-align: center; }

.nav-btns {
  display: flex;
  gap: 24rpx;
  margin: 24rpx;
}
.nav-btn { flex: 1; }
