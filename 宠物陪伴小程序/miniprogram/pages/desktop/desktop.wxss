/* 桌面态：在小程序内模拟「手机桌面」，宠物自主走动 */
/* 用视口固定定位铺满：不依赖 100vh 的具体换算，
   状态栏/安全区/不同机型都由视口自身负责，底部不会留白 */
.desk {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #E8F1F4;
}

/* ---------- 壁纸 ---------- */
.wall {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, #DCEBF5 0%, #E7F2EC 58%, #F0F6F0 100%);
}
.sun {
  position: absolute;
  top: 120rpx; right: 90rpx;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: #FCEFC9;
}
.cloud {
  position: absolute;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 100rpx;
}
.cloud-1 { width: 180rpx; height: 60rpx; top: 220rpx; left: 60rpx; }
.cloud-2 { width: 120rpx; height: 48rpx; top: 300rpx; right: 140rpx; opacity: 0.8; }
.cloud-3 { width: 90rpx; height: 36rpx; top: 160rpx; left: 300rpx; opacity: 0.6; }
.hill {
  position: absolute;
  border-radius: 50%;
}
.hill-back {
  width: 1400rpx; height: 700rpx;
  left: -320rpx; bottom: -380rpx;
  background: #DDEBE2;
}
.hill-front {
  width: 1600rpx; height: 760rpx;
  right: -420rpx; bottom: -460rpx;
  background: #D2E5D9;
  opacity: 0.85;
}

/* ---------- 夜色 ---------- */
/* 夜色是「换背景」，不是「盖一层」。
   这块夜层压在壁纸之上、图标与宠物之下（z 1），内容不再被半透明蒙层糊成一片灰，
   图标和文字各自按夜间配色走，明暗层次才立得住 */
.veil {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 1;
  opacity: 0;
  pointer-events: none;
  overflow: hidden;
  transition: opacity 0.9s ease;
  /* 与陪伴页的舞台夜景同一套色，两处夜景别各走一套 */
  background: linear-gradient(180deg, #101A2E 0%, #1B2740 42%, #2A3A57 72%, #22304A 100%);
}
.veil.on { opacity: 1; }

/* 夜里保住地平线：亮的壁纸被夜层整个盖住，山丘要在这儿重新长出来，
   否则夜景就是一块平板 */
.n-hill {
  position: absolute;
  border-radius: 50%;
}
.n-hill-back {
  width: 1500rpx; height: 640rpx;
  left: -360rpx; bottom: -430rpx;
  background: #1A2436;
}
.n-hill-front {
  width: 1700rpx; height: 680rpx;
  right: -470rpx; bottom: -510rpx;
  background: #141D2C;
}
/* 四角轻微压暗，视线收到中间，夜景才有纵深 */
.n-vignette {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: radial-gradient(120% 80% at 50% 40%, rgba(0, 0, 0, 0) 40%, rgba(4, 8, 18, 0.45) 100%);
}

.stars {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 640rpx;
  z-index: 2;
  opacity: 0;
  pointer-events: none;
  transition: opacity 1.2s ease;
}
.desk.night .stars { opacity: 1; }
.star {
  position: absolute;
  width: 5rpx; height: 5rpx;
  border-radius: 50%;
  background: #F3F7FF;
  /* 没有光晕的小白点在深底上会脏成噪点，加一圈微光才像星星 */
  box-shadow: 0 0 10rpx rgba(214, 230, 255, 0.85);
  animation: twinkle 3.2s ease-in-out infinite;
}
.star.lg {
  width: 9rpx; height: 9rpx;
  box-shadow: 0 0 18rpx rgba(226, 238, 255, 0.95);
}
@keyframes twinkle {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

/* 白天是太阳，夜里换成偏冷的月亮。月亮要浮在夜层之上，所以给 z 3 */
.sun { transition: background 0.9s ease; z-index: 3; }
.desk.night .sun {
  background: radial-gradient(circle at 38% 34%, #FFFDF3 0%, #F2F4E6 72%, #E3E8D7 100%);
  box-shadow: 0 0 60rpx rgba(226, 236, 214, 0.45), 0 0 130rpx rgba(178, 200, 238, 0.16);
}

/* 夜间文字反色，否则深色字压在深色壁纸上看不清 */
.desk.night .sb-clock,
.desk.night .desk-label { color: rgba(232, 238, 242, 0.82); }
.desk.night .sb-back {
  background: rgba(255, 255, 255, 0.16);
  color: #E8EEF2;
}
.desk.night .sig-bar,
.desk.night .bat-fill { background: #E8EEF2; }
.desk.night .sb-battery { border-color: rgba(232, 238, 242, 0.78); }
.desk.night .demo-tag { color: rgba(232, 238, 242, 0.5); }
.desk.night .center-tip { color: rgba(232, 238, 242, 0.8); }

/* 图标：白天是浅色瓷片，夜里原样放着就是一排发光方块。
   不整体调暗（emoji 会糊成灰点），只压到 0.78 并换深色投影，色相留着 */
.desk.night .icon-tile {
  opacity: 0.78;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.38), inset 0 0 0 1rpx rgba(255, 255, 255, 0.12);
}
.desk.night .icon-name { color: rgba(224, 233, 243, 0.9); }

/* 宠物：白底圆在夜里是整屏最亮的一块，像灯箱。换成深色玻璃 + 冷色描边 */
.desk.night .pet-emoji {
  background: rgba(18, 27, 44, 0.62);
  /* 只靠深色玻璃会整块融进夜空，补一圈很淡的月光轮廓把它托起来 */
  box-shadow: inset 0 0 0 2rpx rgba(226, 238, 255, 0.18),
              0 10rpx 26rpx rgba(0, 0, 0, 0.4),
              0 0 34rpx rgba(150, 180, 220, 0.12);
}
.desk.night .pet-photo {
  border-color: rgba(226, 238, 255, 0.42);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.45);
}
.desk.night .pet-shadow { background: rgba(0, 0, 0, 0.32); }

/* 空白处双击的接收层：在最底下，不挡图标和宠物 */
.tap-layer {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 2;
}

/* ---------- 状态栏 ---------- */
.statusbar {
  position: relative;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 8rpx;
}
.sb-left { display: flex; align-items: center; }
.sb-back {
  width: 56rpx; height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 44rpx;
  color: #2E3A33;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 50%;
}
.sb-clock {
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2E3A33;
}
.sb-right { display: flex; align-items: center; }
.sb-signal { display: flex; align-items: flex-end; height: 24rpx; }
.sig-bar {
  width: 6rpx;
  margin-left: 4rpx;
  background: #2E3A33;
  border-radius: 2rpx;
  opacity: 0.75;
}
.s1 { height: 8rpx; }
.s2 { height: 13rpx; }
.s3 { height: 18rpx; }
.s4 { height: 24rpx; }
.sb-battery {
  width: 44rpx; height: 22rpx;
  margin-left: 14rpx;
  border: 2rpx solid #2E3A33;
  border-radius: 6rpx;
  padding: 3rpx;
  box-sizing: border-box;
}
.bat-fill {
  width: 68%;
  height: 100%;
  background: #2E3A33;
  border-radius: 2rpx;
}

.desk-label {
  position: relative;
  z-index: 20;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(46, 58, 51, 0.5);
}
.desk-mood {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.6);
  letter-spacing: 0;
}
.desk.night .desk-mood {
  background: rgba(255, 255, 255, 0.14);
  color: rgba(232, 238, 242, 0.9);
}

/* ---------- 图标网格 ---------- */
.icons {
  position: relative;
  z-index: 10;
  display: flex;
  flex-wrap: wrap;
  padding: 40rpx 40rpx 0;
}
.icon {
  width: 25%;
  margin-bottom: 32rpx;
  text-align: center;
}
.icon-tile {
  width: 96rpx; height: 96rpx;
  margin: 0 auto;
  border-radius: 26rpx;
  font-size: 44rpx;
  line-height: 96rpx;
  box-shadow: 0 4rpx 14rpx rgba(38, 49, 43, 0.08);
}
.icon-name {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(46, 58, 51, 0.62);
}

/* 宠物走到这一列下方时，整列图标被顶得抖一下 */
.icon.shake {
  animation: icon-shake 0.6s ease;
}
@keyframes icon-shake {
  0%, 100% { transform: translateX(0) rotate(0); }
  15% { transform: translateX(-8rpx) rotate(-4deg); }
  32% { transform: translateX(8rpx) rotate(4deg); }
  48% { transform: translateX(-6rpx) rotate(-3deg); }
  64% { transform: translateX(5rpx) rotate(2deg); }
  82% { transform: translateX(-2rpx) rotate(-1deg); }
}

/* ---------- 宠物 ---------- */
.pet-layer {
  position: absolute;
  bottom: 230rpx;
  left: 0;
  width: 200rpx;
  margin-left: -100rpx;
  z-index: 20;
  /* 横向位移走 transform：合成层上做，不触发 layout，拖动才跟得住手指 */
  transition-property: transform;
  transition-timing-function: linear;
  will-change: transform;
}
/* 提起层：只负责纵向，和横向走动互不干扰 */
.pet-lift {
  position: relative;
  transition: transform 0.34s cubic-bezier(0.34, 1.25, 0.64, 1);
}
.pet-lift.lifted {
  transition: transform 0.08s linear;
}
/* 拖动中一律不要过渡，手指到哪儿宠物到哪儿 */
.pet-lift.dragging {
  transition: none;
}
.pet-shadow {
  position: absolute;
  left: 32rpx;
  bottom: -12rpx;
  width: 136rpx;
  height: 26rpx;
  background: rgba(38, 49, 43, 0.13);
  border-radius: 50%;
  transition: width 0.3s ease, left 0.3s ease, opacity 0.3s ease;
}
/* 被提起来时影子变小变淡：离地越高，影子越弱 */
.pet-shadow.up {
  left: 52rpx;
  width: 96rpx;
  opacity: 0.45;
}
.pet-shadow.walking {
  animation: shadow-step 0.5s ease-in-out infinite;
}
@keyframes shadow-step {
  0%, 100% { opacity: 0.85; transform: scaleX(1); }
  50% { opacity: 0.6; transform: scaleX(0.88); }
}
.pet-facing {
  width: 200rpx;
  transition: transform 0.25s ease;
}
.pet-bob {
  animation: idle-bob 3s ease-in-out infinite;
}
.pet-bob.walking {
  animation: walk-bob 0.5s ease-in-out infinite;
}
/* 跑：频率更高、幅度更大，放在 walking 之后覆盖它 */
.pet-bob.running {
  animation: run-bob 0.26s ease-in-out infinite;
}
/* 被拎在手里：以头顶为轴轻轻晃 */
.pet-bob.dangling {
  transform-origin: 50% 4%;
  animation: dangle 1.15s ease-in-out infinite;
}
@keyframes dangle {
  0%, 100% { transform: rotate(-7deg) translateY(0); }
  50% { transform: rotate(7deg) translateY(5rpx); }
}
.pet-avatar {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  text-align: center;
}
.pet-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  box-sizing: border-box;
  box-shadow: 0 10rpx 26rpx rgba(38, 49, 43, 0.16);
}
.pet-emoji {
  width: 180rpx;
  height: 180rpx;
  line-height: 180rpx;
  font-size: 130rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  box-shadow: 0 10rpx 26rpx rgba(38, 49, 43, 0.12);
}
/* 去白底的主体：不给圆框、不给白边、不给落地阴影（阴影由 .pet-shadow 单独负责），
   让它靠自己的轮廓站在桌面上。加边框就前功尽弃了 —— 白卡片正是这么来的 */
.pet-cut {
  display: block;
  width: 180rpx;
  height: 180rpx;
}
/* 只剩线条时黑线夜里会糊进深蓝，翻成亮线。主体带填充的那种不翻，一翻身体就变黑 */
.desk.night .pet-cut.line {
  filter: invert(1);
}

/* 待机 / 走动 / 动作反馈：全部只用 transform，避免 setData 每帧刷样式 */
@keyframes idle-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
@keyframes walk-bob {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-14rpx) rotate(2deg); }
}
.anim-happy { animation: pop 0.7s ease; }
.anim-eat { animation: eat 0.9s ease; }
.anim-bounce { animation: bounce 0.9s ease; }
.anim-bump { animation: bump 0.6s ease; }
.anim-land { animation: land 0.55s cubic-bezier(0.34, 1.4, 0.64, 1); }

@keyframes pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.12) rotate(4deg); }
  100% { transform: scale(1); }
}
@keyframes eat {
  0%, 100% { transform: scale(1) rotate(0); }
  25% { transform: scale(0.94) rotate(-6deg); }
  50% { transform: scale(1.06) rotate(5deg); }
  75% { transform: scale(0.96) rotate(-4deg); }
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  30% { transform: translateY(-56rpx); }
  55% { transform: translateY(0); }
  75% { transform: translateY(-20rpx); }
}
/* 顶图标：短促往上一顶，落回时带一点压缩感 */
@keyframes bump {
  0%, 100% { transform: translateY(0) scale(1); }
  26% { transform: translateY(-46rpx) scale(1.06); }
  46% { transform: translateY(0) scale(1.08, 0.94); }
  66% { transform: translateY(-14rpx) scale(1.02); }
}
@keyframes run-bob {
  0%, 100% { transform: translateY(0) rotate(-5deg); }
  50% { transform: translateY(-24rpx) rotate(5deg); }
}
/* 落地：压扁再回弹，配合影子恢复 */
@keyframes land {
  0% { transform: scale(1); }
  30% { transform: scale(1.16, 0.78) translateY(8rpx); }
  62% { transform: scale(0.94, 1.08) translateY(-8rpx); }
  100% { transform: scale(1); }
}

/* 表情脸：动作之外再给一张脸，情绪一眼能看出 */
.pet-face {
  position: absolute;
  right: -8rpx;
  top: -12rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 38rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 4rpx 14rpx rgba(38, 49, 43, 0.18);
  animation: fade-in 0.2s ease;
}

/* 零食 / 小球：从脚边冒出来 */
.eat-food, .play-ball {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  margin-left: -24rpx;
  font-size: 46rpx;
  line-height: 1;
  pointer-events: none;
}
.eat-food { animation: food-fly 1.15s ease-out forwards; }
.play-ball { animation: ball-hop 1.2s ease-out forwards; }
@keyframes food-fly {
  0% { transform: translateY(-24rpx) scale(0.5); opacity: 0; }
  24% { transform: translateY(-46rpx) scale(1); opacity: 1; }
  100% { transform: translateY(-128rpx) scale(0.4); opacity: 0; }
}
@keyframes ball-hop {
  0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
  18% { transform: translate(0, -66rpx) scale(1); opacity: 1; }
  44% { transform: translate(46rpx, 0); }
  68% { transform: translate(96rpx, -48rpx); }
  100% { transform: translate(146rpx, 14rpx) scale(0.6); opacity: 0; }
}

/* 小心心 */
.hearts {
  position: absolute;
  left: 0; right: 0;
  bottom: 150rpx;
  height: 200rpx;
  pointer-events: none;
}
.heart {
  position: absolute;
  bottom: 0;
  font-size: 36rpx;
  animation: heart-up 1.2s ease-out forwards;
}
@keyframes heart-up {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  20% { opacity: 1; }
  100% { transform: translateY(-180rpx) scale(1.1); opacity: 0; }
}

/* ---------- 气泡 / 引导 ---------- */
.bubble {
  position: absolute;
  bottom: 440rpx;
  transform: translateX(-50%);
  max-width: 420rpx;
  z-index: 25;
  transition-property: transform;
  transition-timing-function: linear;
  will-change: transform;
  padding: 14rpx 26rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--text);
  box-shadow: 0 6rpx 20rpx rgba(38, 49, 43, 0.14);
}
.guide {
  position: relative;
  z-index: 25;
  margin: 8rpx auto 0;
  padding: 12rpx 28rpx;
  background: rgba(38, 49, 43, 0.66);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 30rpx;
  animation: fade-in 0.4s ease;
}
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ---------- Dock ---------- */
.dock {
  position: absolute;
  left: 40rpx; right: 40rpx;
  bottom: 28rpx;
  height: 140rpx;
  z-index: 15;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 44rpx;
}
.dock-item {
  width: 96rpx; height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 44rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 26rpx;
  transition: transform 0.12s ease, opacity 0.2s ease;
}
.dock-item:active {
  transform: scale(0.9);
}
/* 抱着宠物的时候，喂饭/陪玩的按钮变淡，暗示"先放下" */
.dock-item.dim {
  opacity: 0.4;
}

.demo-tag {
  position: absolute;
  right: 32rpx;
  bottom: 186rpx;
  z-index: 25;
  font-size: 20rpx;
  color: rgba(46, 58, 51, 0.4);
}

/* ---------- 加载 / 失败 ---------- */
.center-tip {
  position: absolute;
  left: 0; right: 0;
  top: 45%;
  z-index: 30;
  text-align: center;
  font-size: 26rpx;
  color: var(--sub);
}
.retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 44rpx;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 40rpx;
  font-size: 26rpx;
}

/* ---------- 日历：一起生活的第 N 天 ---------- */
.tg-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(18, 24, 28, 0.44);
  animation: tg-fade 0.2s ease;
}
/* 只做一次入场淡入，不是 infinite 循环——这一页已经有 18 个循环动画了 */
@keyframes tg-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.tg-card {
  width: 540rpx;
  max-height: 84vh;
  overflow-y: auto;
  padding: 48rpx 44rpx 36rpx;
  border-radius: 34rpx;
  background: #FFFFFF;
  box-shadow: 0 24rpx 64rpx rgba(20, 30, 26, 0.2);
  text-align: center;
}

.tg-eyebrow {
  font-size: 24rpx;
  color: var(--sub);
  letter-spacing: 2rpx;
}

.tg-big {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 10rpx;
}
.tg-day {
  font-size: 96rpx;
  font-weight: 500;
  line-height: 1.1;
  color: var(--text);
}
.tg-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: var(--sub);
}

.tg-since {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--sub);
}

.tg-stats {
  display: flex;
  margin-top: 36rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #EEF1EE;
  border-bottom: 1rpx solid #EEF1EE;
}
.tg-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tg-num {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text);
}
.tg-cap {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--sub);
}

.tg-mile {
  margin-top: 32rpx;
}
.tg-mile-txt {
  font-size: 22rpx;
  color: var(--sub);
}
.tg-bar {
  margin-top: 14rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #EDF1EE;
  overflow: hidden;
}
.tg-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--primary);
  transition: width 0.4s ease;
}

.tg-close {
  margin-top: 34rpx;
  padding: 20rpx 0;
  border-radius: 40rpx;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 27rpx;
}

/* 夜里弹层不能还是一张白纸，否则跟刚做完的夜色打架 */
.desk.night .tg-card {
  background: rgba(26, 36, 54, 0.97);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.5);
}
.desk.night .tg-day,
.desk.night .tg-num {
  color: #E8EFF8;
}
.desk.night .tg-eyebrow,
.desk.night .tg-since,
.desk.night .tg-cap,
.desk.night .tg-mile-txt {
  color: rgba(214, 226, 240, 0.62);
}
.desk.night .tg-unit {
  color: rgba(214, 226, 240, 0.72);
}
.desk.night .tg-stats {
  border-top-color: rgba(255, 255, 255, 0.09);
  border-bottom-color: rgba(255, 255, 255, 0.09);
}
.desk.night .tg-bar {
  background: rgba(255, 255, 255, 0.12);
}
.desk.night .tg-bar-fill {
  background: #8FC7AB;
}
.desk.night .tg-close {
  background: rgba(143, 199, 171, 0.16);
  color: #9FD4B8;
}
