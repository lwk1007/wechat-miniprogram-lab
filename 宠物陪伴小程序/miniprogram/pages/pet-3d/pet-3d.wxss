/* 照片立体 · 实验台
   舞台裁切是为了两点：模糊背景不能糊到卡片外面；前景高光冲出边界才有「在画面前面」的感觉 */
.p3d {
  min-height: 100vh;
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
  background: #0E1319;
  display: flex;
  flex-direction: column;
}

.p3d-head { padding: 8rpx 0 20rpx; }
.p3d-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #E8EEF5;
  letter-spacing: 1rpx;
}
.p3d-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(232, 238, 245, 0.45);
}

.p3d-stage {
  position: relative;
  width: 100%;
  height: 640rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #12181F;
  /* 模糊层在合成层上，提示浏览器提前建层，避免每帧重建 */
  will-change: transform;
}

.p3d-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 位移是逐帧改的，不加过渡：加了会滞后于手指/倾斜 */
  will-change: transform;
}

/* 背景：放大到比舞台大，缩放 + 位移后四边仍不露底 */
.p3d-bg-img {
  width: 760rpx;
  height: 760rpx;
  opacity: 0.55;
}
.p3d-bg-empty {
  background: radial-gradient(60% 60% at 50% 45%, #24303C 0%, #12181F 100%);
  opacity: 1;
}

/* 主体：照片卡 */
.p3d-card {
  width: 470rpx;
  height: 470rpx;
  border-radius: 34rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.55);
}

/* 主体：抠图（透明 PNG），不加圆角不加阴影，靠自身轮廓立住 */
.p3d-cut {
  width: 520rpx;
  height: 520rpx;
}
/* 线稿去掉白纸后只剩黑线，深色舞台上翻成亮线。
   白天浅色场景反过来，不加这个 class 就是黑线 —— 一张图两种场景都能用 */
.p3d-cut.inv {
  filter: invert(1);
}

.p3d-emoji {
  font-size: 220rpx;
  line-height: 1;
  filter: drop-shadow(0 18rpx 30rpx rgba(0, 0, 0, 0.5));
}

/* 落地阴影：不是装饰，它是「这东西站在画面里」而不是浮在画面上的关键 */
.p3d-ground {
  position: absolute;
  bottom: 62rpx;
  left: 50%;
  width: 300rpx;
  height: 40rpx;
  margin-left: -150rpx;
  border-radius: 50%;
  background: radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0) 72%);
}

/* 前景高光：斜向的一条冷光 + 一个暖色光斑，位移最大 */
.p3d-front {
  background:
    radial-gradient(28% 22% at 76% 24%, rgba(255, 238, 205, 0.16) 0%, rgba(255, 238, 205, 0) 70%),
    linear-gradient(126deg, rgba(210, 232, 255, 0) 38%, rgba(210, 232, 255, 0.1) 50%, rgba(210, 232, 255, 0) 62%);
  pointer-events: none;
}

.p3d-vignette {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background: radial-gradient(72% 72% at 50% 46%, rgba(0, 0, 0, 0) 52%, rgba(0, 0, 0, 0.42) 100%);
}

.p3d-readout {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
}
.p3d-num {
  font-size: 22rpx;
  color: rgba(232, 238, 245, 0.62);
  font-variant-numeric: tabular-nums;
}
/* 环境提示单独一行用琥珀色：模拟器没陀螺仪、选图失败这类事不能和读数混一起 */
.p3d-hint {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #F2C879;
}

.p3d-panel { margin-top: 24rpx; }

.p3d-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.p3d-label {
  width: 96rpx;
  font-size: 24rpx;
  color: rgba(232, 238, 245, 0.45);
}

.p3d-seg {
  flex: 1;
  margin-right: 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}
.p3d-seg:last-child { margin-right: 0; }

.p3d-opt {
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(232, 238, 245, 0.6);
}
.p3d-opt.on {
  background: rgba(120, 200, 160, 0.22);
  color: #9FE3BF;
  font-weight: 500;
}

.p3d-btn {
  flex: 1;
  margin-right: 14rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 24rpx;
  color: rgba(232, 238, 245, 0.8);
}
.p3d-btn:last-child { margin-right: 0; }

/* 摆动中的状态色，和选项选中态同一套绿 */
.p3d-btn.on {
  background: rgba(120, 200, 160, 0.22);
  border-color: rgba(159, 227, 191, 0.42);
  color: #9FE3BF;
}

/* 选图单独占一行：它是这个页面唯一的入口动作，不该和调参按钮挤在一起 */
.p3d-btn-wide {
  flex: none;
  width: 100%;
  border-style: dashed;
}

/* 逐像素处理时按钮要显得「在忙」，否则用户会连点 */
.p3d-btn.busy {
  opacity: 0.55;
  color: rgba(232, 238, 245, 0.45);
}

/* 校准只在真机有意义，降成一条文字链接，不占视觉重量 */
.p3d-link {
  margin-top: 4rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 21rpx;
  color: rgba(232, 238, 245, 0.32);
}

.p3d-note {
  margin-top: 28rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: rgba(232, 238, 245, 0.32);
}
