<!-- 照片立体 · 实验台
     三层各自位移：back（模糊背景）/ mid（主体）/ front（高光）。
     位移值全部在 js 里算好，这里只负责把 transform 拼出来。 -->
<view class="p3d">

  <view class="p3d-head">
    <view class="p3d-title">照片立体 · 实验台</view>
    <view class="p3d-sub">{{petName ? '当前：' + petName : '当前：未命名'}}　{{mode === 'cutout' ? '抠图模式' : '卡片模式'}}</view>
  </view>

  <view
    class="p3d-stage"
    bindtouchstart="onStageStart"
    catchtouchmove="onStageMove"
    bindtouchend="onStageEnd"
    bindtouchcancel="onStageEnd"
  >
    <!-- 背景：同一张照片放大 + 模糊，位移最小。
         抠图模式下把它收掉：白底图糊开就是一整片白，比没有背景更糟 -->
    <view class="p3d-layer" style="transform: translate3d({{off.back.x}}px, {{off.back.y}}px, 0) scale({{scaleBack}})">
      <image wx:if="{{photo && mode !== 'cutout'}}" class="p3d-bg-img" src="{{photo}}" mode="aspectFill" style="filter: blur({{blur}}px)" />
      <view wx:else class="p3d-bg-img p3d-bg-empty"></view>
    </view>

    <!-- 主体：有抠图用抠图（透明前景），没有就用照片卡 -->
    <view class="p3d-layer" style="transform: translate3d({{off.mid.x}}px, {{off.mid.y}}px, 0)">
      <image wx:if="{{cutout}}" class="p3d-cut {{invert ? 'inv' : ''}}" src="{{cutout}}" mode="aspectFit" />
      <image wx:elif="{{photo}}" class="p3d-card" src="{{photo}}" mode="aspectFill" />
      <view wx:else class="p3d-emoji">{{emoji}}</view>
      <view class="p3d-ground"></view>
    </view>

    <!-- 前景高光：位移最大，制造「有东西在画面前面」 -->
    <view class="p3d-layer p3d-front" style="transform: translate3d({{off.front.x}}px, {{off.front.y}}px, 0)"></view>

    <!-- 轻微暗角，把注意力收到中间 -->
    <view class="p3d-vignette"></view>
  </view>

  <!-- 两行分开：上面永远回姿态数值，下面只说「这个环境该怎么操作」，
       不然一动起来提示就被数字冲掉了 -->
  <view class="p3d-readout">
    <view class="p3d-num">{{readout}}</view>
    <view wx:if="{{hint}}" class="p3d-hint">{{hint}}</view>
  </view>

  <view class="p3d-panel">
    <view class="p3d-row">
      <text class="p3d-label">模式</text>
      <view class="p3d-seg" data-mode="card" bindtap="pickMode">
        <view class="p3d-opt {{mode === 'card' ? 'on' : ''}}">卡片</view>
      </view>
      <view class="p3d-seg" data-mode="cutout" bindtap="pickMode">
        <view class="p3d-opt {{mode === 'cutout' ? 'on' : ''}}">抠图</view>
      </view>
    </view>

    <view class="p3d-row">
      <text class="p3d-label">景深</text>
      <view
        wx:for="{{strengths}}"
        wx:key="*this"
        class="p3d-seg"
        data-value="{{item}}"
        bindtap="setStrength"
      >
        <view class="p3d-opt {{strength === item ? 'on' : ''}}">{{item}}</view>
      </view>
    </view>

    <view class="p3d-row">
      <view class="p3d-btn {{demo ? 'on' : ''}}" bindtap="toggleDemo">{{demo ? '停止摆动' : '自动摆动'}}</view>
      <view class="p3d-btn {{working ? 'busy' : ''}}" bindtap="makeCutout">{{working ? '处理中…' : '去白底'}}</view>
    </view>

    <view class="p3d-row">
      <view class="p3d-btn p3d-btn-wide" bindtap="pickPhoto">选一张照片 / 换一张</view>
    </view>

    <view class="p3d-link" bindtap="recalibrate">重新校准（真机用）</view>
  </view>

  <view class="p3d-note">
    模拟器里没有陀螺仪，点「自动摆动」或按住画面拖动就能看厚度；真机上直接倾斜手机。
    选图只在本地预览，不上传、不改宠物档案，刷新就恢复成档案里那张。
    「去白底」只对付白纸背景（手绘、白墙、表情包），背景里真有东西时还得接分割接口。
  </view>
</view>
