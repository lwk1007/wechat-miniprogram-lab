.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.chat-banner { margin: 16rpx 24rpx; }

.msg-list {
  flex: 1;
  overflow: hidden;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.chat-intro { padding: 32rpx 48rpx; }

.msg-row {
  display: flex;
  margin-top: 32rpx;
}
.msg-right { flex-direction: row-reverse; }
.msg-col { max-width: 76%; }
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-light);
  font-size: 40rpx;
  line-height: 72rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.msg-name { font-size: 22rpx; color: var(--sub); margin: 0 8rpx 8rpx; }

.bubble {
  background: #fff;
  border-radius: 4rpx 24rpx 24rpx 24rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  word-break: break-all;
  position: relative;
}
.bubble-user {
  background: var(--primary);
  color: #fff;
  border-radius: 24rpx 4rpx 24rpx 24rpx;
}
.demo-tag {
  font-size: 18rpx;
  color: var(--sub);
  margin-top: 8rpx;
}
.bubble-user .demo-tag { color: rgba(255, 255, 255, 0.75); }

.msg-status {
  font-size: 22rpx;
  color: var(--sub);
  margin: 8rpx;
}
.msg-right .msg-status { text-align: right; }
.msg-fail { color: var(--danger); }

/* 等待中气泡 */
.typing { display: flex; gap: 10rpx; align-items: center; padding: 28rpx; }
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  opacity: 0.5;
  animation: typing 1.2s infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes typing {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 0.9; }
}

.msg-bottom-space { height: 32rpx; }

/* 快捷话题 */
.topics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 24rpx 0;
}
.topic {
  background: #fff;
  color: var(--primary);
  font-size: 24rpx;
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
}
.topic:active { opacity: 0.7; }

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
}
.chat-input {
  flex: 1;
  background: var(--bg);
  border-radius: 40rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
}
.send-btn {
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
}
.send-disabled { opacity: 0.5; }

/* #4 语音对话 */

/* 播报开关 */
.chat-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx 0;
}
.tool {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--sub);
  background: #fff;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}
.tool-on {
  color: var(--primary);
  background: var(--primary-light);
}
.tool-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.45;
}
.tool-on .tool-dot { opacity: 1; }
.tool-hint { font-size: 22rpx; color: var(--sub); }

/* 打字机进行中的光标，让「正在说」有个视觉落点 */
.bubble-typing::after {
  content: '';
  display: inline-block;
  width: 4rpx;
  height: 28rpx;
  background: var(--primary);
  margin-left: 6rpx;
  vertical-align: -4rpx;
  animation: caret 0.8s steps(1) infinite;
}
@keyframes caret {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

/* 新消息提示 */
.new-tip {
  align-self: center;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  margin-bottom: 8rpx;
}

/* 语音输入 */
.mode-btn {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border-radius: 50%;
}
.mode-btn:active { background: var(--bg); }

.voice-hold {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: var(--bg);
  border-radius: 40rpx;
  font-size: 28rpx;
}
.voice-hold-on {
  background: var(--primary);
  color: #fff;
}

/* 录音浮层 */
.rec-mask {
  position: fixed;
  inset: 0;
  background: rgba(38, 49, 43, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.rec-box {
  width: 480rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}
.rec-wave {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 64rpx;
  margin-bottom: 28rpx;
}
.rec-bar {
  width: 8rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: var(--primary);
  animation: wave 1s infinite ease-in-out;
}
.rec-bar:nth-child(2) { animation-delay: 0.15s; }
.rec-bar:nth-child(3) { animation-delay: 0.3s; }
.rec-bar:nth-child(4) { animation-delay: 0.45s; }
.rec-bar:nth-child(5) { animation-delay: 0.6s; }
@keyframes wave {
  0%, 100% { height: 20rpx; opacity: 0.5; }
  50% { height: 56rpx; opacity: 1; }
}
.rec-text {
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 80rpx;
  margin-bottom: 16rpx;
  word-break: break-all;
}
.rec-hint { font-size: 22rpx; color: var(--sub); }
