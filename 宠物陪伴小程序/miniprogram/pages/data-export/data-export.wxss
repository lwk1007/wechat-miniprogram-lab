.intro {
  margin-bottom: 8rpx;
}

.meta {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.stat-row {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 24rpx 0;
}

.stat {
  width: 33.33%;
  box-sizing: border-box;
  padding: 20rpx 8rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.stat:nth-child(3n + 1) { border-top-right-radius: 8rpx; border-bottom-right-radius: 8rpx; }
.stat:nth-child(3n) { border-top-left-radius: 8rpx; border-bottom-left-radius: 8rpx; }

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #3E3528;
}

.stat-label {
  font-size: 24rpx;
  color: #8A7D68;
}

.section {
  padding-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.hint {
  font-size: 24rpx;
}

.line {
  font-size: 26rpx;
  color: #5A4B3A;
  line-height: 1.7;
  padding: 14rpx 0;
  border-top: 1rpx solid #E9DFCA;
  white-space: pre-wrap;
  word-break: break-all;
}

.line:first-of-type {
  border-top: none;
}

.empty {
  padding: 12rpx 0;
}

.copy-btn {
  margin: 32rpx 24rpx 12rpx;
}

.footer-note {
  font-size: 24rpx;
  padding: 0 48rpx 24rpx;
  line-height: 1.6;
}
