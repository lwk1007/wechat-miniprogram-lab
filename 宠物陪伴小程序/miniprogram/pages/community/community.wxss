.page { padding-bottom: 160rpx; }

.post-head { display: flex; align-items: center; }
.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.post-head-info { flex: 1; margin-left: 16rpx; }
.post-name { font-size: 28rpx; font-weight: 500; }
.post-more {
  color: var(--sub);
  font-size: 32rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  font-weight: bold;
}

.post-content {
  margin-top: 16rpx;
  font-size: 28rpx;
  word-break: break-all;
  white-space: pre-wrap;
}

.post-images { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.images-1 .post-image { width: 100%; height: 360rpx; }
.images-2 .post-image, .images-3 .post-image {
  width: calc(50% - 6rpx);
  height: 240rpx;
}

.post-actions {
  display: flex;
  gap: 48rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}
.post-action { font-size: 26rpx; color: var(--sub); }
.post-action.liked { color: var(--danger); }
.action-count { margin-left: 8rpx; }

.load-more { padding: 24rpx 0; }
.empty-btn { width: 320rpx; margin: 32rpx auto 0; }

/* 右下角浮动操作：切换模式 + 发布（避开右上角胶囊） */
.dock-actions {
  position: fixed;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 16;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}
.act-btn {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  box-shadow: 0 6rpx 20rpx rgba(38, 49, 43, 0.22);
}
.act-btn:active { opacity: 0.85; }
.act-primary {
  background: var(--primary);
  color: #FFFFFF;
  font-size: 46rpx;
  box-shadow: 0 8rpx 24rpx rgba(111, 165, 138, 0.4);
}
.act-ghost {
  background: rgba(32, 42, 37, 0.62);
  color: #FFFFFF;
  font-size: 24rpx;
}

/* 评论面板 */
.panel-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(38, 49, 43, 0.35);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}
.panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 16rpx;
  box-sizing: border-box;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.panel-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.panel-list { max-height: 50vh; }
.panel-tip { padding: 48rpx 0; }

.comment { padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.comment-head { display: flex; justify-content: space-between; }
.comment-name { font-size: 26rpx; color: var(--primary); }
.comment-content { font-size: 28rpx; margin-top: 4rpx; word-break: break-all; }
.comment-del {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 8rpx;
  display: inline-block;
}

.panel-input-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-bottom: 16rpx;
}
.panel-input {
  flex: 1;
  background: var(--bg);
  border-radius: 40rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
}
.panel-send {
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 36rpx;
  font-size: 28rpx;
}
.panel-send-disabled { opacity: 0.5; }

/* ==================================================================
   沉浸式全屏浏览（上下滑）
   布局说明：swiper 每屏一个 swiper-item，内部用绝对定位分层——
   铺底图 → 压暗渐变 → 主体（居中）→ 右侧动作栏 → 底部信息 → 顶部悬浮栏
   ================================================================== */
/* 沉浸模式：整页固定到可视区域（顶部到屏幕顶、底部到 tabBar 顶），
   高度全靠视口自适应，不使用任何 JS 算出来的像素值 —— 换机型、改字号、分屏都不会错位 */
.page-feed {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  height: 100%;
  padding-bottom: 0;
  overflow: hidden;
}
.page-feed .feed {
  height: 100%;
}
.feed { position: relative; }

.swiper { width: 100%; }
.page-feed .swiper { height: 100%; }

.slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #1B211E;
}

/* 铺底：同一张图放大模糊，照片上下留白也不会空 */
.slide-bg {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  opacity: 0.6;
  filter: blur(24rpx);
  transform: scale(1.12);
}
.slide-bg-empty {
  background: linear-gradient(150deg, #26332D 0%, #3C5148 55%, #55705F 100%);
  filter: none;
  opacity: 1;
  transform: none;
}
.slide-shade {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.44) 0%,
    rgba(0, 0, 0, 0.12) 28%,
    rgba(0, 0, 0, 0.18) 60%,
    rgba(0, 0, 0, 0.74) 100%
  );
}

/* 主体区：用 flex 居中，四边留出顶栏与底部信息的空间 */
.slide-stage {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 96rpx 340rpx;
  box-sizing: border-box;
}
.slide-hero { width: 100%; height: 100%; }
.slide-quote {
  font-size: 46rpx;
  line-height: 1.66;
  font-weight: 500;
  color: #FFFFFF;
  text-align: center;
  word-break: break-all;
}

.slide-badge {
  position: absolute;
  right: 32rpx;
  top: 200rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.42);
  border-radius: 20rpx;
}

/* 右侧动作栏 */
.rail {
  position: absolute;
  right: 20rpx;
  bottom: 330rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}
.rail-btn { text-align: center; }
.rail-icon {
  font-size: 54rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.45);
}
.rail-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
}
.rail-btn.liked .rail-count { color: #FFC2BB; }

/* 底部信息 */
.slide-meta {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 40rpx 150rpx 44rpx 32rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.5) 100%);
}
.slide-user { display: flex; align-items: center; }
.slide-avatar {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  color: #FFFFFF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.slide-name {
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
.slide-time {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}
.slide-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #FFFFFF;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.35);
}

/* 顶部悬浮栏 */
/* 顶部栏：高度与位置由胶囊按钮实测值决定（见 js 里 navTop / navH） */
.topbar {
  position: absolute;
  left: 0; right: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.topbar-left { display: flex; align-items: center; }
.topbar-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.45);
}
.topbar-count {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
/* 刷新按钮：贴着标题右侧，不与胶囊争位置 */
.topbar-refresh {
  margin-left: 18rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}
.topbar-refresh-dark { color: var(--sub); background: var(--primary-light); }

/* 列表模式的顶部栏（高度同样由胶囊实测值决定） */
.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.list-title { font-size: 40rpx; font-weight: 600; }

/* 首屏上滑提示 */
.swipe-hint {
  position: absolute;
  left: 50%;
  bottom: 250rpx;
  z-index: 13;
  padding: 12rpx 30rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 30rpx;
  animation: hint-float 1.7s ease-in-out infinite;
}
@keyframes hint-float {
  0%, 100% { transform: translate(-50%, 0); opacity: 0.85; }
  50% { transform: translate(-50%, -16rpx); opacity: 1; }
}

.feed-tip {
  position: absolute;
  left: 0; right: 0;
  top: 42%;
  text-align: center;
  font-size: 26rpx;
  color: var(--sub);
}
.feed-tip-icon { font-size: 76rpx; margin-bottom: 12rpx; }
.feed-tip-btn { width: 320rpx; margin: 28rpx auto 0; }

.feed-loading {
  position: absolute;
  left: 50%;
  bottom: 140rpx;
  transform: translateX(-50%);
  padding: 10rpx 28rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.42);
  border-radius: 24rpx;
}
