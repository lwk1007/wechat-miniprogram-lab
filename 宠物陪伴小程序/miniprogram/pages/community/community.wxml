<view class="page {{mode === 'feed' ? 'page-feed' : ''}}">

  <!-- ============ 沉浸式上下滑（默认） ============ -->
  <block wx:if="{{mode === 'feed'}}">
    <view class="feed">
      <!-- 加载中 -->
      <view wx:if="{{loading && !posts.length}}" class="feed-tip">正在加载动态…</view>
      <view wx:elif="{{error && !posts.length}}" class="feed-tip">{{error}}</view>
      <view wx:elif="{{!posts.length}}" class="feed-tip">
        <view class="feed-tip-icon">🌱</view>
        <view>还没有动态，记录第一件小事吧</view>
        <view class="btn-ghost feed-tip-btn" bindtap="goPublish">分享今天的小事</view>
      </view>

      <swiper
        wx:else
        class="swiper"
        vertical
        circular="{{false}}"
        duration="260"
        current="{{current}}"
        bindchange="onSwipe"
      >
        <swiper-item wx:for="{{posts}}" wx:key="_id">
          <view class="slide">
            <!-- 模糊铺底 + 压暗，保证任何照片上的白字都读得清 -->
            <image wx:if="{{item.cover}}" class="slide-bg" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="slide-bg slide-bg-empty"></view>
            <view class="slide-shade"></view>

            <!-- 主体：有照片就居中显示照片，没照片就用大字 -->
            <view class="slide-stage">
              <image
                wx:if="{{item.cover}}"
                class="slide-hero"
                src="{{item.cover}}"
                mode="aspectFit"
                data-urls="{{item.images}}"
                data-current="{{item.cover}}"
                bindtap="previewImage"
              />
              <view wx:else class="slide-quote">{{item.content || '今天也很好'}}</view>
            </view>

            <view wx:if="{{item.imageCount > 1}}" class="slide-badge">共 {{item.imageCount}} 张</view>

            <!-- 右侧动作栏 -->
            <view class="rail">
              <view class="rail-btn {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" bindtap="toggleLike">
                <view class="rail-icon">{{item.liked ? '❤️' : '🤍'}}</view>
                <view class="rail-count">{{item.likeCount || 0}}</view>
              </view>
              <view class="rail-btn" data-id="{{item._id}}" bindtap="openComments">
                <view class="rail-icon">💬</view>
                <view class="rail-count">{{item.commentCount || 0}}</view>
              </view>
              <view class="rail-btn" data-id="{{item._id}}" bindtap="more">
                <view class="rail-icon">⋯</view>
                <view class="rail-count">更多</view>
              </view>
            </view>

            <!-- 底部信息 -->
            <view class="slide-meta">
              <view class="slide-user">
                <view class="slide-avatar">{{item.ownerName[0]}}</view>
                <text class="slide-name">{{item.ownerName}}</text>
                <text class="slide-time">{{item.timeText}}</text>
              </view>
              <view wx:if="{{item.cover && item.content}}" class="slide-text">{{item.content}}</view>
            </view>
          </view>
        </swiper-item>
      </swiper>

      <!-- 顶部悬浮栏：右上角留给微信胶囊，内容只放左边 -->
      <view
        class="topbar"
        style="top: {{navTop}}px; height: {{navH}}px; padding-left: 28rpx; padding-right: {{navPadRight}}px"
      >
        <view class="topbar-left">
          <text class="topbar-title">社区</text>
          <text wx:if="{{posts.length}}" class="topbar-count">{{current + 1}}/{{posts.length}}</text>
          <view class="topbar-refresh" bindtap="onRefresh">↻</view>
        </view>
      </view>

      <!-- 首次进入的上滑提示 -->
      <view wx:if="{{showHint}}" class="swipe-hint">上滑看下一条</view>

      <view wx:if="{{loadingMore}}" class="feed-loading">加载中…</view>
    </view>
  </block>

  <!-- ============ 列表模式（类似朋友圈的浏览方式） ============ -->
  <block wx:else>
    <view class="list-header" style="height: {{navTop + navH}}px; padding-top: {{navTop}}px">
      <view class="list-title">社区</view>
      <view class="topbar-refresh topbar-refresh-dark" bindtap="onRefresh">↻</view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="empty">
      <view class="empty-icon">🐾</view>
      <view>正在加载动态…</view>
    </view>

    <!-- 加载失败 -->
    <view wx:elif="{{error}}" class="empty">
      <view class="empty-icon">🌧️</view>
      <view>{{error}}</view>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{posts.length === 0}}" class="empty">
      <view class="empty-icon">🌱</view>
      <view>还没有动态，记录第一件小事吧</view>
      <view class="btn-ghost empty-btn" bindtap="goPublish">分享今天的小事</view>
    </view>

    <!-- 信息流 -->
    <block wx:else>
      <view wx:for="{{posts}}" wx:key="_id" class="post card">
        <view class="post-head">
          <view class="post-avatar">{{item.ownerName[0]}}</view>
          <view class="post-head-info">
            <view class="post-name">{{item.ownerName}}</view>
            <view class="sub">{{item.timeText}}</view>
          </view>
          <view class="post-more" data-id="{{item._id}}" bindtap="more">···</view>
        </view>

        <view class="post-content" wx:if="{{item.content}}">{{item.content}}</view>

        <view wx:if="{{item.imageCount}}" class="post-images images-{{item.imageCount}}">
          <image
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:key="*this"
            class="post-image"
            src="{{img}}"
            mode="aspectFill"
            data-urls="{{item.images}}"
            data-current="{{img}}"
            bindtap="previewImage"
          />
        </view>

        <view class="post-actions">
          <view class="post-action {{item.liked ? 'liked' : ''}}" data-id="{{item._id}}" bindtap="toggleLike">
            <text>{{item.liked ? '❤️' : '🤍'}}</text>
            <text class="action-count">{{item.likeCount}}</text>
          </view>
          <view class="post-action" data-id="{{item._id}}" bindtap="openComments">
            <text>💬</text>
            <text class="action-count">{{item.commentCount}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{loadingMore}}" class="sub center load-more">加载中…</view>
      <view wx:elif="{{!hasMore}}" class="sub center load-more">没有更多了</view>
    </block>

  </block>

  <!-- 右下角浮动操作：切换浏览模式 + 发布。放这里是为了避开右上角胶囊 -->
  <view class="dock-actions">
    <view class="act-btn act-ghost" bindtap="switchMode">{{mode === 'feed' ? '列表' : '沉浸'}}</view>
    <view class="act-btn act-primary" bindtap="goPublish">＋</view>
  </view>

  <!-- 评论面板（两种模式共用） -->
  <view wx:if="{{panel.visible}}" class="panel-mask" bindtap="closePanel">
    <view class="panel safe-bottom" catchtap="noop">
      <view class="panel-title">评论</view>
      <scroll-view class="panel-list" scroll-y>
        <view wx:if="{{panel.loading}}" class="sub center panel-tip">加载中…</view>
        <view wx:elif="{{panel.comments.length === 0}}" class="sub center panel-tip">还没有评论，说点什么吧</view>
        <view wx:for="{{panel.comments}}" wx:key="_id" class="comment">
          <view class="comment-head">
            <view class="comment-name">{{item.ownerName}}</view>
            <view class="sub">{{item.timeText}}</view>
          </view>
          <view class="comment-content">{{item.content}}</view>
          <view wx:if="{{item.mine}}" class="comment-del" data-id="{{item._id}}" bindtap="deleteComment">删除</view>
        </view>
      </scroll-view>
      <view class="panel-input-bar">
        <input
          class="panel-input"
          placeholder="友善评论，留下小脚印"
          value="{{panel.input}}"
          maxlength="200"
          bindinput="onPanelInput"
          cursor-spacing="16"
        />
        <view class="panel-send {{panel.submitting ? 'panel-send-disabled' : ''}}" bindtap="submitComment">
          {{panel.submitting ? '发送中' : '发送'}}
        </view>
      </view>
    </view>
  </view>
</view>
