.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.6;
}
.char-count { text-align: right; margin-top: 8rpx; }

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}
.image-thumb { width: 100%; height: 100%; border-radius: 16rpx; }
.image-add {
  background: var(--bg);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--primary);
}
.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(38, 49, 43, 0.7);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice {
  margin: 0 24rpx;
  padding: 20rpx 24rpx;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 16rpx;
  font-size: 24rpx;
}

.publish-btn { margin: 32rpx 24rpx; }
