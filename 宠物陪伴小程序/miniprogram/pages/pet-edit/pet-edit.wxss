.photo-tip { margin: 8rpx 0 24rpx; }
.photo-wrap { position: relative; }
.photo {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  background: var(--bg);
}
.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: var(--primary);
}
.photo-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: rgba(38, 49, 43, 0.45);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 0 0 24rpx 24rpx;
}

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 12rpx 40rpx;
  background: var(--bg);
  border-radius: 40rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}
.chip-on {
  background: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary);
}

.save-btn { margin: 24rpx; }
.picker-value { color: var(--text); }
