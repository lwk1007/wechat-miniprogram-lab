.photo-tip { margin: 8rpx 0 24rpx; }
.photo-wrap { position: relative; }
.photo {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  background: var(--bg);
}
.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: var(--primary);
}
.photo-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: rgba(38, 49, 43, 0.45);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 0 0 24rpx 24rpx;
}

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 12rpx 40rpx;
  background: var(--bg);
  border-radius: 40rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}
.chip-on {
  background: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary);
}

.save-btn { margin: 24rpx; }
.picker-value { color: var(--text); }

/* #9 性格自定义 */
.persona-base { margin-top: 24rpx; }
.persona-preview {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}
.persona-preview-label {
  font-size: 22rpx;
  color: var(--primary);
  margin-bottom: 8rpx;
}
.persona-preview-text {
  font-size: 28rpx;
  line-height: 1.6;
}
.persona-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--primary);
}
.persona-arrow { font-size: 22rpx; }
.persona-body {
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}
.chip-sm { padding: 10rpx 28rpx; font-size: 26rpx; }
.form-hint {
  font-size: 22rpx;
  color: var(--sub);
  margin-left: 12rpx;
}
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 96rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.form-divider {
  font-size: 24rpx;
  color: var(--sub);
  margin: 16rpx 0 24rpx;
}
.persona-note {
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.6;
  margin-top: 8rpx;
}
